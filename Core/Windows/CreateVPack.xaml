<Window x:Class="VComm.Core.Windows.CreateVPack"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="VPack Builder" Height="760" Width="1120" MinHeight="620" MinWidth="720"
        Background="#FF181818" WindowStartupLocation="CenterOwner" SizeChanged="Window_SizeChanged" WindowStyle="None"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FFFFAF00"/>
        <SolidColorBrush x:Key="Panel" Color="#FF242424"/>
        <SolidColorBrush x:Key="Muted" Color="#FFAAAAAA"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource VCommTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource VCommComboBox}"/>
        <Style TargetType="Button" BasedOn="{StaticResource VCommButton}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource VCommCheckBox}"/>
        <Style TargetType="ProgressBar" BasedOn="{StaticResource VCommProgressBar}"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource VCommScrollBar}"/>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource VCommPrimaryButton}"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#FF101010" BorderBrush="#FF303030" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Accent}" Margin="0,0,9,0">
                        <TextBlock Text="V" Foreground="#FF111111" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="VPACK BUILDER" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="―" Style="{StaticResource VCommTitleBarButton}" Click="MinimizeWindow_Click"/>
                    <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource VCommTitleBarButton}" Click="MaximizeWindow_Click"/>
                    <Button Content="✕" Style="{StaticResource VCommTitleBarButton}" Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="VPACK BUILDER" FontFamily="Jepanten" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text="Turn spoken phrases into game actions — no JSON required." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="SAVE PACK" Style="{StaticResource PrimaryButton}" Click="SavePack_Click"
                    MinWidth="130" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <WrapPanel>
                <StackPanel Width="360" Margin="0,0,18,0">
                    <TextBlock Text="PACK NAME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <TextBox x:Name="PackNameBox" TextChanged="PackDetails_Changed"/>
                    <TextBlock x:Name="PackNameError" Foreground="#FFFF6B6B" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Width="300">
                    <TextBlock Text="AUTHOR" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <TextBox x:Name="AuthorBox" TextChanged="PackDetails_Changed"/>
                    <TextBlock Text="Optional — shown with your pack." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Grid x:Name="BuilderGrid" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="CommandRow" Height="*"/><RowDefinition x:Name="ResponsiveGapRow" Height="0"/>
                <RowDefinition x:Name="EditorRow" Height="0"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CommandColumn" Width="300"/><ColumnDefinition x:Name="GapColumn" Width="16"/>
                <ColumnDefinition x:Name="EditorColumn" Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="CommandPanel" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="VOICE COMMANDS" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CommandCount" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ListBox x:Name="CommandList" Grid.Row="1" SelectionChanged="CommandList_SelectionChanged"
                             Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ItemContainerStyle="{StaticResource VCommListBoxItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5,7">
                                    <TextBlock Text="{Binding PrimaryPhrase}" Foreground="#FFF5F5F5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Summary}" Foreground="#FFAAAAAA" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" Content="+ ADD VOICE COMMAND" Click="AddCommand_Click" Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <Border x:Name="EditorPanel" Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="COMMAND DETAILS" FontWeight="Bold"/>
                            <TextBlock Text="Any phrase below runs the action sequence in order." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="DUPLICATE" Click="DuplicateCommand_Click" Margin="0,0,8,0" Padding="9,5"/>
                            <Button Content="DELETE" Click="DeleteCommand_Click" Padding="9,5"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="WHAT SHOULD THE PLAYER SAY?" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                            <ItemsControl x:Name="PhraseList" Margin="0,7,0,5">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FF343434" CornerRadius="5" Margin="0,0,0,6" Padding="9,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}" Foreground="#FFF5F5F5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                <Button Grid.Column="1" Content="REMOVE" Click="RemovePhrase_Click" Padding="7,3" Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="PhraseBox" KeyDown="PhraseBox_KeyDown" ToolTip="Example: red team, stack up"/>
                                <Button Grid.Column="1" Content="ADD PHRASE" Click="AddPhrase_Click" Margin="8,0,0,0"/>
                                <Button x:Name="ListenPhraseButton" Grid.Column="2" Content="🎙 SAY IT" Click="ListenPhrase_Click"
                                        Margin="8,0,0,0" ToolTip="Use your microphone to fill this phrase"/>
                            </Grid>
                            <Grid x:Name="ListeningPanel" Visibility="Collapsed" Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Ellipse Width="9" Height="9" Fill="#FFFFAF00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="ListeningText" Text="Listening… say the phrase naturally" FontWeight="SemiBold"/>
                                    <ProgressBar x:Name="CaptureLevel" Height="4" Maximum="100" Margin="0,5,12,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="CANCEL" Click="CancelPhraseCapture_Click" Padding="8,3"/>
                            </Grid>
                            <TextBlock x:Name="PhraseError" Foreground="#FFFF6B6B" FontSize="12" Margin="0,5,0,14"/>

                            <TextBlock Text="WHAT SHOULD VCOMM DO?" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                            <Border Background="#FF1B1B1B" BorderBrush="#FF424242" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,7,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="InputPicker" IsEditable="True" IsTextSearchEnabled="True"
                                                  ItemsSource="{Binding AvailableInputs, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  ToolTip="Choose an input or type one such as F7, MMB or LCTRL"/>
                                        <CheckBox x:Name="HoldInputCheck" Grid.Column="1" Content="KEEP HELD" Foreground="White"
                                                  VerticalAlignment="Center" Margin="12,0" ToolTip="Keep this input down until the complete sequence has run"/>
                                        <Button Grid.Column="2" Content="ADD STEP" Click="AddAction_Click"/>
                                    </Grid>
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Tip: held inputs stay down while every following step runs, then release safely at the end."
                                                   Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <Button x:Name="RecordInputsButton" Grid.Column="1" Content="● RECORD KEY SEQUENCE"
                                                Click="RecordInputs_Click" Margin="12,0,0,0" Padding="9,5"
                                                ToolTip="Record modifier chords and key presses directly from your keyboard"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="RecordingPanel" Background="#26FFAF00" BorderBrush="#FFFFAF00" BorderThickness="1"
                                    CornerRadius="5" Padding="10" Visibility="Collapsed" Margin="0,0,0,8">
                                <TextBlock Text="RECORDING — press your sequence now. Modifier keys such as Left Ctrl are kept held. Click STOP when finished."
                                           TextWrapping="Wrap" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="ActionError" Foreground="#FFFF6B6B" FontSize="12" Margin="0,0,0,7" TextWrapping="Wrap"/>
                            <TextBlock Text="SEQUENCE PREVIEW" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                            <ItemsControl x:Name="ActionList" Margin="0,7,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FF343434" CornerRadius="5" Margin="0,0,0,6" Padding="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Position}" Foreground="#FFFFAF00" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding DisplayToken}" Foreground="#FFF5F5F5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Behaviour}" Foreground="#FFAAAAAA" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Content="↑" Click="MoveActionUp_Click" Padding="7,3"/>
                                                    <Button Content="↓" Click="MoveActionDown_Click" Padding="7,3" Margin="4,0"/>
                                                    <Button Content="REMOVE" Click="RemoveAction_Click" Padding="7,3"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="DELAY AFTER EACH ACTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBox x:Name="DelayBox" Width="100" TextChanged="DelayBox_TextChanged"/>
                                <TextBlock Text="milliseconds" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="9,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="DelayError" Foreground="#FFFF6B6B" FontSize="12" Margin="0,5,0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,100,0"/>
            <Button Content="CANCEL" Click="Cancel_Click" HorizontalAlignment="Right" Padding="16,7"/>
        </Grid>
        </Grid>
    </Grid>
</Window>
