<Window x:Class="VComm.Core.Windows.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="VComm Settings" Closed="Window_Closed" PreviewMouseDown="Window_PreviewMouseDown"
        SizeChanged="Window_SizeChanged" Height="720" Width="960" MinHeight="600" MinWidth="720"
        Background="#FF151515" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#FFFFAF00"/>
        <SolidColorBrush x:Key="Panel" Color="#FF232323"/>
        <SolidColorBrush x:Key="Muted" Color="#FFAAAAAA"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource VCommButton}"><Setter Property="MinHeight" Value="34"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource VCommPrimaryButton}"><Setter Property="MinHeight" Value="36"/></Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource VCommCheckBox}">
            <Setter Property="Margin" Value="0,6"/><Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource VCommComboBox}"/>
        <Style TargetType="Slider" BasedOn="{StaticResource VCommSlider}"><Setter Property="Margin" Value="0,10,0,5"/></Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource VCommScrollBar}"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="HelpText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#FF101010" BorderBrush="#FF303030" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource Accent}" Margin="0,0,9,0">
                        <TextBlock Text="V" Foreground="#FF111111" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="VCOMM SETTINGS" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="―" Style="{StaticResource VCommTitleBarButton}" Click="MinimizeWindow_Click"/>
                    <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource VCommTitleBarButton}" Click="MaximizeWindow_Click"/>
                    <Button Content="✕" Style="{StaticResource VCommTitleBarButton}" Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="28,24,28,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="8" Background="#FFFFAF00" Margin="0,0,14,0">
                <TextBlock Text="V" Foreground="#FF151515" FontFamily="Jepanten" FontWeight="Bold" FontSize="28"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="VCOMM SETTINGS" FontFamily="Jepanten" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Voice controls, game input and feedback — changes save automatically."
                           Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="SettingsGrid" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition x:Name="SettingsResponsiveGapRow" Height="0"/>
                    <RowDefinition x:Name="SettingsRightRow" Height="0"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsLeftColumn" Width="*"/>
                    <ColumnDefinition x:Name="SettingsGapColumn" Width="18"/>
                    <ColumnDefinition x:Name="SettingsRightColumn" Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="LeftSettingsPanel">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="VOICE ACTIVATION" Style="{StaticResource SectionLabel}"/>
                            <CheckBox x:Name="PTTCheck" Content="Use push-to-talk" Checked="PTTCheck_Checked" Unchecked="PTTCheck_Unchecked"/>
                            <Grid Margin="0,8,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Activation input" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Button x:Name="PTTKey" Grid.Column="1" Content="CAPS LOCK" Click="PTTKey_Click"
                                        KeyDown="PTTKey_KeyDown" IsEnabled="False" FontWeight="SemiBold"/>
                            </Grid>
                            <TextBlock Text="Click the input button, then press a keyboard or mouse button." Style="{StaticResource HelpText}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="RECOGNITION" Style="{StaticResource SectionLabel}"/>
                            <Grid>
                                <TextBlock Text="Minimum confidence"/>
                                <TextBlock x:Name="ConfidenceValue" Text="65%" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/>
                            </Grid>
                            <Slider x:Name="ConfidenceSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="ConfidenceSlider_ValueChanged"/>
                            <TextBlock Text="Raise this if commands trigger accidentally; lower it if valid commands are missed."
                                       Style="{StaticResource HelpText}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="COMMAND PACK" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="Active VPack" Margin="0,0,0,7"/>
                            <ComboBox x:Name="VPackList" SelectionChanged="VPackList_SelectionChanged"/>
                            <Grid Margin="0,10,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Content="NEW PACK" Click="NewVPack_Click" Style="{StaticResource PrimaryButton}"/>
                                <Button Grid.Column="2" Content="EDIT ACTIVE PACK" Click="EditVPack_Click"/>
                            </Grid>
                            <TextBlock Text="Build trigger phrases and input sequences visually. Recognition reloads when Settings closes."
                                       Style="{StaticResource HelpText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RightSettingsPanel" Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="OVERLAY &amp; FEEDBACK" Style="{StaticResource SectionLabel}"/>
                            <CheckBox x:Name="OverlayCheck" Content="Show the in-game overlay" Checked="OverlayCheck_Checked" Unchecked="OverlayCheck_Unchecked"/>
                            <CheckBox x:Name="RecognitionTextCheck" Content="Show recognized speech" Checked="RecognitionTextCheck_Checked" Unchecked="RecognitionTextCheck_Unchecked"/>
                            <CheckBox x:Name="ChimeCheck" Content="Play a chime when a command runs" Checked="ChimeCheck_Checked" Unchecked="ChimeCheck_Unchecked"/>
                            <Grid Margin="0,8,0,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Content="CHOOSE CHIME…" Click="ChooseChime_Click"/>
                                <Button Grid.Column="2" Content="RESET" Click="ResetChime_Click"/>
                            </Grid>
                            <TextBlock x:Name="ChimePathText" Text="Default chime" Style="{StaticResource HelpText}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <Grid Margin="0,16,0,0">
                                <TextBlock Text="Overlay opacity"/>
                                <TextBlock x:Name="OpacityValue" Text="35%" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/>
                            </Grid>
                            <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="OpacitySlider_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="GAME INPUT" Style="{StaticResource SectionLabel}"/>
                            <Grid>
                                <TextBlock Text="Key press duration"/>
                                <TextBlock x:Name="PressDurationValue" Text="75 ms" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource Accent}"/>
                            </Grid>
                            <Slider x:Name="PressDurationSlider" Minimum="10" Maximum="500" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="PressDurationSlider_ValueChanged"/>
                            <TextBlock Text="Increase this if a game misses simulated inputs. VPack sequences can add a separate delay after every step."
                                       Style="{StaticResource HelpText}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SEQUENCE CAPABILITIES" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Style="{StaticResource HelpText}"
                                       Text="Keyboard, mouse buttons, side buttons and wheel directions are supported. The VPack Builder can record keyboard sequences directly. Mark an input Keep held to hold it through every following step, then release it safely at the end."/>
                            <Border Background="#FF191919" CornerRadius="5" Padding="10" Margin="0,10,0,0">
                                <TextBlock Text="Example: HOLD LCTRL  →  UP  →  LEFT  →  RIGHT  →  DOWN" FontFamily="Consolas"
                                           Foreground="#FFFFD36A" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="BuildInfo" Foreground="#FF777777" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="MADE WITH 💜 BY DEVLIN" Foreground="#FF777777" FontWeight="Bold"
                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Grid x:Name="FirstRun" Grid.RowSpan="3" Background="#F2151515" Visibility="Collapsed">
            <Border Background="#FF232323" CornerRadius="10" Padding="42" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="680" Margin="28">
                <StackPanel>
                    <TextBlock Text="WELCOME TO VCOMM" FontFamily="Jepanten" FontSize="36" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock Margin="0,20,0,24" TextWrapping="Wrap" TextAlignment="Center" FontSize="16"
                               Text="Choose a command pack and configure voice activation here. Use the VPack Builder to speak or type trigger phrases, then record the game input sequence that should run."/>
                    <Button x:Name="IntroDoneBtn" Click="IntroDoneBtn_Click" Content="LET'S SET IT UP"
                            HorizontalAlignment="Center" Width="220" Style="{StaticResource PrimaryButton}" FontFamily="Jepanten" FontSize="17"/>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
